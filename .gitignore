# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# nuxt
/.nuxt/
/.output/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
# On PARTAGE le système d'orchestration pour qu'il voyage avec le repo et soit
# reconnaissable par tout agent : contexte (glossaire-adjacent, catalogue DS,
# vision produit), skills, commands, et les settings projet.
# Seul le fichier personnel settings.local.json reste local.
.claude/*
!.claude/context/
!.claude/skills/
!.claude/commands/
!.claude/settings.json

# Lyse local cache
.lyse/
